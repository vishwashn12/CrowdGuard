# CrowdGuard environment overrides.
#
# Copy to .env and edit. Every value here is optional: anything unset falls back
# to the YAML config. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# ── Venue ────────────────────────────────────────────────────────────────────
# VENUE_CONFIG=config/venue/circular_venue.yaml

# ── Compute ──────────────────────────────────────────────────────────────────
# auto | cpu | cuda
# DEVICE=auto

# ── Ingestion rates ──────────────────────────────────────────────────────────
# CSRNet sampling rate per camera. Density changes slowly, so this can stay low.
# DENSITY_FPS=5

# Pose/anomaly decimation. 1 = every frame, which is the rate the anomaly
# classifier was trained at. Raise it ONLY if the GPU cannot keep up; run
# scripts/benchmark_gpu.py to find the right value for your hardware. Anything
# above 1 makes sitting and counter-flow detection approximate.
# ANOMALY_STRIDE=1

# Pace reads to the source frame rate. Set false to process files flat out.
# REAL_TIME_MODE=true

# Restart uploaded clips on EOF, so short demo files keep a gate live.
# LOOP_SOURCES=true

# ── CSRNet (crowd density) ───────────────────────────────────────────────────
# CSRNET_ENABLED=true
# CSRNET_CHECKPOINT=checkpoints/PartAmodel_best.pth

# ── YOLO pose + ByteTrack ────────────────────────────────────────────────────
# Must be a *-pose checkpoint: the anomaly features need the 17 keypoints.
# yolov8s-pose.pt is roughly 2x faster if you are short of GPU headroom.
# POSE_ENABLED=true
# POSE_MODEL=assets/yolov8m-pose.pt
# POSE_CONF=0.15
# POSE_IMGSZ=960

# ── Anomaly classifier ───────────────────────────────────────────────────────
# Disabling this keeps pose tracking and crowd motion, and falls back to the
# geometric counter-flow rule for behaviour.
# ANOMALY_ENABLED=true
# ANOMALY_CLASSIFIER=assets/best_model.pkl
